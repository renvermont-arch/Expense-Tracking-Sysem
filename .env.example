# XAMPP MySQL defaults — copy this file to .env and edit if you changed them
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=expense_tracker

# Port for the REST API
PORT=3001

# Hosted API for a published GitHub Pages build.
# Leave blank: the published app stores data on the device (local mode).
# Set to e.g. https://your-api.onrender.com/api to use a hosted MySQL backend.
VITE_API_BASE_URL=

# GitHub Pages project path, e.g. /expense-tracker/
# Leave as / for a user/organization site or local development.
VITE_BASE_PATH=/

# Comma-separated origins allowed to call a hosted API, e.g.
# https://your-name.github.io,https://your-name.github.io/expense-tracker/
ALLOWED_ORIGINS=
